{
  "name": "MerlAIn",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    // .NET 10 SDK — the host only has 3.1, so this is what makes `dotnet build` work.
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    // Matches the Node version the web Dockerfile builds with.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    // Docker *outside* of Docker: installs the CLI + compose plugin and binds the
    // host's /var/run/docker.sock. Containers you start are siblings of this one,
    // running on the host daemon — not nested. `docker compose up` from in here
    // brings up the same stack you'd get from a host terminal.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "installDockerBuildx": true,
      "installDockerComposeSwitch": false
    }
  },

  // Attach to the stack's bridge network so `postgres`, `redis`, `api`, ... resolve
  // by service name from inside this container. Runs on every start because a
  // `docker compose down` tears the network down and takes the attachment with it.
  "postStartCommand": "bash .devcontainer/join-network.sh",

  "postCreateCommand": "npm install",

  "containerEnv": {
    // Consumed by apps/web/vite.config.ts. On the host this would be localhost;
    // from inside the dev container the API is reachable at its service name.
    "VITE_DEV_API_TARGET": "http://api:8080",
    "MERLAIN_NETWORK": "merlain"
  },

  // Vite dev server. The compose stack owns :80 (Traefik) on the host already.
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "dotnet.defaultSolution": "MerlAIn.slnx",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "vscode"
}

# =============================================================================
# MerlAIn - copy to .env and adjust. Never commit .env.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=merlain
POSTGRES_USER=merlain
POSTGRES_PASSWORD=change-me

# --- Redis -------------------------------------------------------------------
REDIS_CONNECTION=redis:6379

# --- Identity ----------------------------------------------------------------
# MerlAIn ships no identity provider. It always issues its own session tokens,
# and supports two ways of proving who you are - they can run side by side:
#
#   1. Local accounts: email + password, stored in the `identity` schema.
#   2. External OIDC (optional): point OIDC_AUTHORITY at a provider you already
#      run - Authentik, Keycloak, Entra ID, Auth0, Zitadel, ... - and the sign-in
#      page grows a "Continue with <OIDC_DISPLAY_NAME>" button.
#
# Leave OIDC_AUTHORITY empty and the button never appears: local accounts only.

# Signs the session tokens MerlAIn issues. Required in both modes.
# Generate with:  openssl rand -base64 64 | tr -d '\n'
AUTH_JWT_SIGNING_KEY=change-me
AUTH_JWT_ISSUER=https://merlain.local

# Local accounts
AUTH_LOCAL_ACCOUNTS_ENABLED=true
AUTH_ALLOW_REGISTRATION=true

# External OIDC - empty OIDC_AUTHORITY disables it entirely.
OIDC_AUTHORITY=
# Only needed when the browser and the API reach the provider on different URLs
# (host name vs container name). Defaults to
# <OIDC_AUTHORITY>/.well-known/openid-configuration when left empty.
OIDC_METADATA_ADDRESS=
OIDC_CLIENT_ID=
# Leave empty for a public client using PKCE, which is the recommended setup.
OIDC_CLIENT_SECRET=
# Expected `aud` claim. Many providers (Authentik included) put the client id here.
OIDC_AUDIENCE=
OIDC_SCOPES=openid profile email
# Label of the sign-in button.
OIDC_DISPLAY_NAME=Single sign-on
# Attach an OIDC login to an existing local account when the verified email matches,
# instead of creating a second account. Set to false if you do not trust the
# provider's email verification.
OIDC_LINK_BY_VERIFIED_EMAIL=true

# --- Object storage (S3 compatible) ------------------------------------------
# Keep as-is to use the bundled MinIO (profile: storage),
# or point at an existing S3 endpoint and skip the profile.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=merlain
S3_SECRET_KEY=change-me
S3_BUCKET=merlain-assets
S3_FORCE_PATH_STYLE=true

# --- LLM inference -----------------------------------------------------------
# LLM_PROVIDER: ollama | openai-compatible
LLM_PROVIDER=ollama
LLM_ENDPOINT=http://ollama:11434
LLM_MODEL=llama3.1
LLM_API_KEY=

# --- Image generation (optional) ---------------------------------------------
# Leave IMAGE_ENDPOINT empty to disable the Artist agent gracefully.
IMAGE_ENDPOINT=
IMAGE_API_KEY=
IMAGE_MODEL=

# --- Frontend ----------------------------------------------------------------
# Everything else, including whether the SSO button shows up, is served at runtime
# by GET /api/auth/config - so the same web image works against any deployment.
VITE_API_BASE_URL=/api
